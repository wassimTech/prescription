# ==============================================================================
# ENVIRONMENT VARIABLES - PRESCRIPTION SAAS BACKEND
# ==============================================================================

# Application
NODE_ENV=development
PORT=3000

# PostgreSQL Configuration (Profile "infra")
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prescription_saas_dev
POSTGRES_PORT=5433

# Database URL for Prisma
# Connects locally on port 5433 (avoids collision with other postgres instances on 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/prescription_saas_dev?schema=public"

# E2E Test Database Configuration (Profile "test")
POSTGRES_TEST_USER=postgres
POSTGRES_TEST_PASSWORD=postgres
POSTGRES_TEST_DB=prescription_test
POSTGRES_TEST_PORT=5434
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5434/prescription_test?schema=public"

# pgAdmin 4 Configuration (Profile "infra")
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5055

# Prisma Studio
PRISMA_STUDIO_PORT=5555

# SonarQube & Sonar-DB Configuration (Profile "tools")
SONARQUBE_PORT=9000
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar_secure_password_2026
SONAR_DB_NAME=sonar
SONAR_TOKEN=your_sonarqube_or_sonarcloud_token
SONAR_HOST_URL=http://localhost:9000

# Security & Secrets
JWT_SECRET=super_secret_jwt_key_2026_change_in_production
JWT_EXPIRATION=7d

# Shopify Integration (Mock or Live)
SHOPIFY_API_KEY=mock_shopify_api_key
SHOPIFY_API_SECRET=mock_shopify_api_secret
SHOPIFY_WEBHOOK_SECRET=mock_webhook_secret
