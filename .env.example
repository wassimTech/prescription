# ==============================================================================
# ENVIRONMENT VARIABLES - LINKERS IT PRESCRIPTION SAAS BACKEND
# ==============================================================================

# Application
NODE_ENV=development
PORT=3000

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=linkers_prescription_dev
POSTGRES_PORT=5433

# Database URL for Prisma
# Connects locally on port 5433 (avoids collision with other postgres instances on 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/linkers_prescription_dev?schema=public"

# pgAdmin 4 Configuration
PGADMIN_DEFAULT_EMAIL=admin@linkers.it
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5055

# Prisma Studio
PRISMA_STUDIO_PORT=5555

# Security & Secrets
JWT_SECRET=super_secret_linkers_it_jwt_key_2026_change_in_production
JWT_EXPIRATION=7d

# Shopify Integration (Mock or Live)
SHOPIFY_API_KEY=mock_shopify_api_key
SHOPIFY_API_SECRET=mock_shopify_api_secret
SHOPIFY_WEBHOOK_SECRET=mock_webhook_secret
