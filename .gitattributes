# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly ensure code and config files use LF
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.prisma text eol=lf
.env* text eol=lf
Dockerfile text eol=lf

# Keep bash/shell scripts strictly LF
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
